{
  "name": "@noctcore/eslint-plugin-prisma",
  "version": "0.5.2",
  "description": "Prisma tenancy, data-integrity and transaction guardrails: unscoped-client and raw-SQL fences, client-supplied tenant ids and request bodies, tenant and soft-delete filters, single-writer models, multi-write transactions and audit placement.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs",
    "README.md"
  ],
  "sideEffects": false,
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "prisma",
    "multi-tenant",
    "transaction",
    "soft-delete",
    "noctcore"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noctcore/eslint-plugins.git",
    "directory": "packages/eslint-plugin-prisma"
  },
  "homepage": "https://noctcore.github.io/eslint-plugins/packages/prisma/",
  "bugs": "https://github.com/noctcore/eslint-plugins/issues",
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@noctcore/eslint-utils": "^0.1.2",
    "@typescript-eslint/utils": "^8.72.1"
  },
  "peerDependencies": {
    "eslint": ">=9.0.0 <11",
    "typescript": ">=5.0.0 <7"
  },
  "devDependencies": {
    "@noctcore/eslint-test-utils": "workspace:*",
    "@types/node": "^22.20.5",
    "@typescript-eslint/parser": "^8.72.1",
    "@typescript-eslint/rule-tester": "^8.72.1",
    "tsup": "^9.0.0",
    "typescript": "^5.6.0",
    "vitest": "^5"
  }
}
