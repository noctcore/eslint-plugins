{
  "name": "@noctcore/lint-meta-rules",
  "version": "0.6.2",
  "description": "Portable, parameterized lint-meta rules — whole-repo / cross-file invariants ESLint cannot reach — for the @noctcore/harness lint-meta runner.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./i18n": {
      "import": {
        "types": "./dist/i18n.d.ts",
        "default": "./dist/i18n.js"
      },
      "require": {
        "types": "./dist/i18n.d.cts",
        "default": "./dist/i18n.cjs"
      }
    },
    "./prisma": {
      "import": {
        "types": "./dist/prisma.d.ts",
        "default": "./dist/prisma.js"
      },
      "require": {
        "types": "./dist/prisma.d.cts",
        "default": "./dist/prisma.cjs"
      }
    },
    "./resolved-config": {
      "import": {
        "types": "./dist/resolved-config.d.ts",
        "default": "./dist/resolved-config.js"
      },
      "require": {
        "types": "./dist/resolved-config.d.cts",
        "default": "./dist/resolved-config.cjs"
      }
    },
    "./session": {
      "import": {
        "types": "./dist/session.d.ts",
        "default": "./dist/session.js"
      },
      "require": {
        "types": "./dist/session.d.cts",
        "default": "./dist/session.cjs"
      }
    },
    "./trpc": {
      "import": {
        "types": "./dist/trpc.d.ts",
        "default": "./dist/trpc.js"
      },
      "require": {
        "types": "./dist/trpc.d.cts",
        "default": "./dist/trpc.cjs"
      }
    },
    "./typescript": {
      "import": {
        "types": "./dist/typescript.d.ts",
        "default": "./dist/typescript.js"
      },
      "require": {
        "types": "./dist/typescript.d.cts",
        "default": "./dist/typescript.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs",
    "README.md"
  ],
  "sideEffects": false,
  "keywords": [
    "lint-meta",
    "noctcore",
    "harness",
    "structure-lock",
    "monorepo",
    "convention"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noctcore/eslint-plugins.git",
    "directory": "packages/lint-meta-rules"
  },
  "homepage": "https://noctcore.github.io/eslint-plugins/packages/lint-meta-rules/",
  "bugs": "https://github.com/noctcore/eslint-plugins/issues",
  "scripts": {
    "build": "tsup src/index.ts src/i18n.ts src/prisma.ts src/resolved-config.ts src/session.ts src/trpc.ts src/typescript.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@noctcore/eslint-plugin-contracts": "^0.7.1",
    "@noctcore/eslint-plugin-prisma": "^0.5.1",
    "@noctcore/harness": "^0.3.0",
    "@typescript-eslint/utils": "^8.72.1"
  },
  "peerDependencies": {
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": ">=9.0.0 <11",
    "typescript": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "@typescript-eslint/parser": {
      "optional": true
    },
    "eslint": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^10.14.0",
    "tsup": "^9.0.0",
    "typescript": "^5.6.0"
  }
}
