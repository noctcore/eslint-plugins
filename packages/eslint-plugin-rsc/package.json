{
  "name": "@noctcore/eslint-plugin-rsc",
  "version": "0.1.2",
  "description": "React Server Components and App Router correctness rules: control-flow errors that must not be swallowed.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs",
    "README.md"
  ],
  "sideEffects": false,
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "react-server-components",
    "rsc",
    "nextjs",
    "app-router",
    "noctcore"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noctcore/eslint-plugins.git",
    "directory": "packages/eslint-plugin-rsc"
  },
  "homepage": "https://noctcore.github.io/eslint-plugins/packages/rsc/",
  "bugs": "https://github.com/noctcore/eslint-plugins/issues",
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@noctcore/eslint-utils": "^0.1.2",
    "@typescript-eslint/utils": "^8.61.1"
  },
  "peerDependencies": {
    "eslint": ">=9.0.0",
    "typescript": ">=5.0.0"
  },
  "devDependencies": {
    "@noctcore/eslint-test-utils": "workspace:*",
    "@types/node": "^22.20.3",
    "@typescript-eslint/parser": "^8.70.0",
    "@typescript-eslint/rule-tester": "^8.70.0",
    "tsup": "^8.5.1",
    "typescript": "^5.6.0",
    "vitest": "^5"
  }
}
