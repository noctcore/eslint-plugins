---
/**
 * The brand as text: `noctcore` with the wavy error underline, then
 * `/eslint-plugins`. Replacing Starlight's SiteTitle drops its scoped styles;
 * components.css styles `.brand`.
 */
const { siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="site-title brand" translate="no" aria-label="noctcore ESLint plugins, home">
  <b>noctcore</b><span>/eslint-plugins</span>
</a>
