---
/**
 * Starlight's right column, with the rule facts panel above "On this page"
 * on a rule page. Same structure as Starlight's own PageSidebar; its scoped
 * styles are restored below.
 */
import MobileTableOfContents from '@astrojs/starlight/components/MobileTableOfContents.astro';
import TableOfContents from '@astrojs/starlight/components/TableOfContents.astro';

import RuleFacts from './RuleFacts.astro';
---

{
  Astro.locals.starlightRoute.toc && (
    <>
      <div class="lg:sl-hidden">
        <MobileTableOfContents />
      </div>
      <div class="right-sidebar-panel sl-hidden lg:sl-block">
        <div class="sl-container">
          <RuleFacts />
          <TableOfContents />
        </div>
      </div>
    </>
  )
}

<style>
  @layer starlight.core {
    .right-sidebar-panel {
      padding: 1.5rem var(--sl-sidebar-pad-x);
    }
    .sl-container {
      width: calc(var(--sl-sidebar-width) - 2 * var(--sl-sidebar-pad-x));
    }
    .right-sidebar-panel :global(:where(starlight-toc a)) {
      display: block;
      text-decoration: none;
      overflow-wrap: anywhere;
    }
  }
</style>
