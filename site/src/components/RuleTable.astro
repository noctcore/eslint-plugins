---
/**
 * A package's rule table, generated from the plugin's exported `rules` and each
 * rule's `meta` via the catalog. Nothing in it is typed by hand.
 */
import DeprecatedNote from './DeprecatedNote.astro';
import { codeSpans, getPackage, href, presetLabel } from '../lib/catalog';

interface Props {
  pkg: string;
}

const pkg = getPackage(Astro.props.pkg);
const isPlugin = pkg.kind === 'eslint-plugin';
const typeLabel = { required: 'required', optional: 'optional', none: '' } as const;
---

<div class="rule-table-wrap">
  <table class="rule-table">
    <thead>
      {
        isPlugin ? (
          <tr>
            <th scope="col">Rule</th>
            <th scope="col">What it reports</th>
            <th scope="col">Preset</th>
            <th scope="col">Fix</th>
            <th scope="col">Types</th>
          </tr>
        ) : (
          <tr>
            <th scope="col">Rule</th>
            <th scope="col">What it enforces</th>
            <th scope="col">Category</th>
            <th scope="col">Entry point</th>
          </tr>
        )
      }
    </thead>
    <tbody>
      {
        pkg.rules.map((rule) =>
          isPlugin ? (
            <tr>
              <td>
                <a href={href(rule.route)}>
                  <code>{rule.name}</code>
                </a>
                <DeprecatedNote rule={rule} />
              </td>
              <td>{codeSpans(rule.description).map(({ part, code }) => (code ? <code>{part}</code> : part))}</td>
              <td>
                <span class:list={['pill', `pill-${presetLabel(rule.recommended).replace(' ', '-')}`]}>
                  {presetLabel(rule.recommended)}
                </span>
              </td>
              <td>{rule.fixable ? 'autofix' : rule.hasSuggestions ? 'suggestion' : ''}</td>
              <td>{typeLabel[rule.typeInfo as keyof typeof typeLabel]}</td>
            </tr>
          ) : (
            <tr>
              <td>
                <a href={href(rule.route)}>
                  <code>{rule.name}</code>
                </a>
              </td>
              <td>{codeSpans(rule.description).map(({ part, code }) => (code ? <code>{part}</code> : part))}</td>
              <td>
                <code>{rule.category}</code>
              </td>
              <td>
                <code>{rule.entry}</code>
              </td>
            </tr>
          ),
        )
      }
    </tbody>
  </table>
</div>
{
  isPlugin && (
    <p class="rule-table-legend">
      <strong>Preset</strong>: severity in <code>configs.recommended</code>; <em>off</em> means the preset
      registers the rule switched off, <em>not listed</em> means it leaves the rule out. <strong>Fix</strong>:
      whether the rule ships an autofix or an editor suggestion. <strong>Types</strong>: whether the rule needs a
      type-checked program (<code>parserOptions.projectService</code>).
    </p>
  )
}
