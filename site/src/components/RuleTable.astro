---
/**
 * A package's rule table, generated from the plugin's exported `rules` and each
 * rule's `meta` via the catalog. Nothing in it is typed by hand.
 */
import DeprecatedNote from './DeprecatedNote.astro';
import RuleBadges from './RuleBadges.astro';
import { codeSpans, getPackage, href } from '../lib/catalog';

interface Props {
  pkg: string;
}

const pkg = getPackage(Astro.props.pkg);
const isPlugin = pkg.kind === 'eslint-plugin';
---

<div class="rule-table-wrap">
  <table class="rule-table">
    <thead>
      {
        isPlugin ? (
          <tr>
            <th scope="col">Rule</th>
            <th scope="col">What it reports</th>
            <th scope="col">Preset</th>
            <th scope="col">Fix</th>
            <th scope="col">Types</th>
          </tr>
        ) : (
          <tr>
            <th scope="col">Rule</th>
            <th scope="col">What it enforces</th>
            <th scope="col">Category</th>
            <th scope="col">Entry point</th>
          </tr>
        )
      }
    </thead>
    <tbody>
      {
        pkg.rules.map((rule) =>
          isPlugin ? (
            <tr>
              <td data-label="Rule">
                <a href={href(rule.route)}>
                  <code>{rule.name}</code>
                </a>
                <DeprecatedNote rule={rule} />
              </td>
              <td data-label="What it reports">
                {codeSpans(rule.description).map(({ part, code }) => (code ? <code>{part}</code> : part))}
              </td>
              <td data-label="Preset"><RuleBadges rule={rule} column="preset" /></td>
              <td data-label="Fix"><RuleBadges rule={rule} column="fix" /></td>
              <td data-label="Types"><RuleBadges rule={rule} column="types" /></td>
            </tr>
          ) : (
            <tr>
              <td data-label="Rule">
                <a href={href(rule.route)}>
                  <code>{rule.name}</code>
                </a>
              </td>
              <td data-label="What it enforces">
                {codeSpans(rule.description).map(({ part, code }) => (code ? <code>{part}</code> : part))}
              </td>
              <td data-label="Category">
                <code>{rule.category}</code>
              </td>
              <td data-label="Entry point">
                <code>{rule.entry}</code>
              </td>
            </tr>
          ),
        )
      }
    </tbody>
  </table>
</div>
{
  isPlugin && (
    <p class="rule-table-legend">
      <strong>Preset</strong>: severity in <code>configs.recommended</code>.{' '}
      <span class="pill pill-off">off</span> means the preset registers the rule switched off,{' '}
      <span class="pill pill-not-listed">not listed</span> means it leaves the rule out; both are{' '}
      <span class="nc-optin">opt-in</span>, so you turn the rule on yourself.{' '}
      <span class="nc-badge nc-badge--options">needs options</span> means it does nothing until you configure it.{' '}
      <strong>Fix</strong>: whether the rule ships an autofix or an editor suggestion. <strong>Types</strong>: whether
      the rule needs a type-checked program (<code>parserOptions.projectService</code>), or uses one when present.
    </p>
  )
}
