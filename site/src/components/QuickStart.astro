---
/**
 * The install block for one package, built from the catalog so the package
 * name cannot drift from the source. A plugin's flat config is built live in
 * the rules board below (RuleTable.astro); the lint-meta catalog, which is no
 * ESLint plugin, keeps its registry snippet here.
 */
import { Code } from '@astrojs/starlight/components';

import { getPackage, plural } from '../lib/catalog';
import { installCommand } from '../lib/config-builder';
import { presetCounts } from '../lib/package-page';

interface Props {
  pkg: string;
}

const pkg = getPackage(Astro.props.pkg);
const install = installCommand(pkg);
const isPlugin = pkg.kind === 'eslint-plugin';

let note: string;
if (isPlugin) {
  const { recommended, strictOnly } = presetCounts(pkg);
  const total = plural(pkg.rules.length, 'rule');
  const builder =
    ' The rules board below builds the flat config: start from a preset, switch single rules between error and off, and copy the result.';
  if (recommended === 0 && strictOnly > 0) {
    note =
      `The recommended preset turns none of its ${total} on: each is a house convention or needs options, ` +
      `so the board starts from strict, which enables ${strictOnly}.${builder}`;
  } else if (recommended === 0) {
    note =
      `The recommended preset turns none of its ${total} on: each needs options only your project can give, ` +
      `so the preset alone checks nothing. Switch a rule on in the board, then fill in its options as the rule's page shows.`;
  } else {
    const strictNote =
      strictOnly === 0 ? '' : ` The strict preset adds ${plural(strictOnly, 'house rule')} (naming, folder shape, size caps) on top.`;
    note = `The recommended preset enables ${recommended} of ${total}.${strictNote}${builder}`;
  }
} else {
  note = `A source catalog for the @noctcore/harness lint-meta runner, not an ESLint plugin. ${plural(pkg.rules.length, 'rule')}.`;
}

const registry = [
  `import { createAllRules, createPackageShapeRule } from '${pkg.npmName}';`,
  '',
  '// Every catalog rule with default options:',
  'const rules = createAllRules();',
  '',
  '// Or one rule, retargeted at your repo:',
  "const shape = createPackageShapeRule({ scope: '@acme' });",
].join('\n');
---

<div class="quickstart">
  <Code code={install} lang="sh" title="Install" />
  {!isPlugin && <Code code={registry} lang="ts" title="registry.ts" />}
  <p class="quickstart-note">{note}</p>
</div>
