{
  "name": "@noctcore/docs-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "sync": "bun scripts/sync.ts",
    "dev": "bun run sync && ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "docs:build": "bun run sync && ASTRO_TELEMETRY_DISABLED=1 astro build && bun scripts/check-build.ts",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "typecheck": "bun run sync && ASTRO_TELEMETRY_DISABLED=1 astro sync && tsc --noEmit",
    "test": "bun test scripts"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.42.8",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/martian-mono": "^5.3.0",
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "astro": "^7.4.5",
    "satteri": "^0.11.6"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^10.14.0",
    "typescript": "^5.6.0"
  }
}
