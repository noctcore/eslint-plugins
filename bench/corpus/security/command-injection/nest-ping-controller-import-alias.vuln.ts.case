// @bench category=command-injection cwe=CWE-78 framework=nest pair=nest-ping-controller-import-alias title="host from @Query concatenated into an exec ping, rewritten by import-alias"
import { Controller as Imported1, Get as Imported2, Query as Imported3 } from '@nestjs/common';
import { exec as imported1 } from 'node:child_process';

@Imported1('network')
export class NetworkController {
  @Imported2('ping')
  ping(@Imported3('host') host: string): Promise<{ output: string }> {
    return new Promise((resolve, reject) => {
      imported1('ping -c 1 ' + host, (error, stdout) => { // expect: security/no-shell-interpolation
        if (error) {
          reject(error);
          return;
        }
        resolve({ output: stdout });
      });
    });
  }
}
