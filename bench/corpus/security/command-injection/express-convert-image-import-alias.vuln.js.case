// @bench category=command-injection cwe=CWE-78 framework=express pair=express-convert-image-import-alias title="uploaded file name from the body interpolated into a promisified exec, rewritten by import-alias"
const imported1 = require('express');
const { promisify: imported2 } = require('node:util');
const { exec: imported3 } = require('node:child_process');

const run = imported2(imported3);
const app = imported1();
app.use(imported1.json());

app.post('/images/convert', async (req, res) => {
  const { file } = req.body;
  try {
    const { stdout } = await run(`convert /uploads/${file} -resize 50% /thumbs/${file}.png`); // expect: security/no-shell-interpolation
    res.json({ ok: true, log: stdout });
  } catch (err) {
    res.status(500).json({ error: 'conversion failed' });
  }
});

app.listen(8080);
