// @bench category=command-injection cwe=CWE-22 framework=express pair=express-workspace-cleanup title="nested workspace path made of dot-free segments removed with rm -rf under /srv"
// ok
import express, { Request, Response } from 'express';
import { execSync } from 'node:child_process';

// Segments of letters, digits and `_` joined by single slashes: no `.`, no leading `/`.
const WORKSPACE_PATH = /^[a-z0-9_]+(\/[a-z0-9_]+)*$/;

const app = express();
app.use(express.json());

app.post('/workspaces/cleanup', (req: Request, res: Response) => {
  const path: string = req.body.path;
  if (typeof path !== 'string' || !WORKSPACE_PATH.test(path)) {
    res.status(400).json({ error: 'invalid path' });
    return;
  }
  execSync(`rm -rf /srv/workspaces/${path}`);
  res.status(204).end();
});

app.listen(3000);
