// @bench category=command-injection cwe=CWE-78 framework=express pair=express-report-hash-windows title="report name limited to word characters put into a command that cmd.exe runs on Windows"
// ok
import express, { Request, Response } from 'express';
import { exec } from 'node:child_process';

// Express has already decoded URL escapes, so no `%` is needed here.
const REPORT = /^\w+\.pdf$/;

const app = express();

app.get('/reports/:name/hash', (req: Request, res: Response) => {
  const { name } = req.params;
  if (!REPORT.test(name)) {
    res.status(400).end();
    return;
  }
  exec(`certutil -hashfile reports/${name} SHA256`, (error, stdout) => {
    if (error) {
      res.status(500).end();
      return;
    }
    res.type('text/plain').send(stdout);
  });
});

app.listen(3000);
