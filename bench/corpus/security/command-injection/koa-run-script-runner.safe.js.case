// @bench category=command-injection cwe=CWE-78 framework=koa pair=koa-run-script-runner title="runner picked from a list of interpreters, so the checked script name stays a local file argument"
// ok
const Koa = require('koa');
const Router = require('@koa/router');
const { bodyParser } = require('@koa/bodyparser');
const { promisify } = require('node:util');
const { exec } = require('node:child_process');

const run = promisify(exec);
// Both interpreters read `script` as a file in /srv/scripts, never as a program to run.
const RUNNERS = ['node', 'tsx'];
const SCRIPT = /^[a-z][a-z0-9-]*$/;
const app = new Koa();
const router = new Router();

router.post('/scripts/run', async (ctx) => {
  const { runner, script } = ctx.request.body;
  if (!RUNNERS.includes(runner) || !SCRIPT.test(script)) {
    ctx.status = 400;
    return;
  }
  const { stdout } = await run(`${runner} ${script}`, { cwd: '/srv/scripts' });
  ctx.body = { output: stdout };
});

app.use(bodyParser());
app.use(router.routes());
app.listen(3000);
