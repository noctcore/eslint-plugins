// @bench category=command-injection cwe=CWE-78 framework=nest pair=nest-ping-controller title="host validated as a hostname, then passed as an argument array to execFile"
// ok
import { BadRequestException, Controller, Get, Query } from '@nestjs/common';
import { execFile } from 'node:child_process';

const HOSTNAME = /^[a-z0-9][a-z0-9.-]{0,252}$/i;

@Controller('network')
export class NetworkController {
  @Get('ping')
  ping(@Query('host') host: string): Promise<{ output: string }> {
    // An argument array stops the shell; the pattern also stops `-f`-style option injection.
    if (!HOSTNAME.test(host)) {
      throw new BadRequestException('invalid host');
    }
    return new Promise((resolve, reject) => {
      execFile('ping', ['-c', '1', host], (error, stdout) => {
        if (error) {
          reject(error);
          return;
        }
        resolve({ output: stdout });
      });
    });
  }
}
