// @bench category=command-injection cwe=CWE-78 framework=express pair=express-ffmpeg-thumb title="file name validated, then passed as a spawnSync argument array without a shell"
// ok
const express = require('express');
const { spawnSync } = require('node:child_process');

const VIDEO_NAME = /^[a-z0-9][a-z0-9_-]{0,63}\.mp4$/i;

const app = express();
app.use(express.json());

app.post('/video/thumbnail', (req, res) => {
  const input = req.body.input;
  // No shell, and a plain file name cannot be an option, a URL or a protocol such as `concat:`.
  if (typeof input !== 'string' || !VIDEO_NAME.test(input)) {
    return res.status(400).json({ error: 'invalid input' });
  }
  const result = spawnSync('ffmpeg', ['-y', '-i', input, '-frames:v', '1', '/tmp/thumb.png']);
  if (result.status !== 0) {
    return res.status(500).json({ error: 'ffmpeg failed' });
  }
  res.sendFile('/tmp/thumb.png');
});

app.listen(3000);
