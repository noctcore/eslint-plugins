// @bench category=command-injection cwe=CWE-78 framework=nest pair=nest-ping-controller-import-alias title="host validated as a hostname, then passed as an argument array to execFile, rewritten by import-alias"
// ok
import { BadRequestException as Imported1, Controller as Imported2, Get as Imported3, Query as Imported4 } from '@nestjs/common';
import { execFile as imported1 } from 'node:child_process';

const HOSTNAME = /^[a-z0-9][a-z0-9.-]{0,252}$/i;

@Imported2('network')
export class NetworkController {
  @Imported3('ping')
  ping(@Imported4('host') host: string): Promise<{ output: string }> {
    // An argument array stops the shell; the pattern also stops `-f`-style option injection.
    if (!HOSTNAME.test(host)) {
      throw new Imported1('invalid host');
    }
    return new Promise((resolve, reject) => {
      imported1('ping', ['-c', '1', host], (error, stdout) => {
        if (error) {
          reject(error);
          return;
        }
        resolve({ output: stdout });
      });
    });
  }
}
