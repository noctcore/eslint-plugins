// @bench category=command-injection cwe=CWE-78 framework=koa pair=koa-dig-name title="record name checked by a pattern that lets a leading + through, then built into a dig command"
const Koa = require('koa');
const Router = require('@koa/router');
const { promisify } = require('node:util');
const { exec } = require('node:child_process');

const run = promisify(exec);
// `+` is allowed for names such as `c++.example.com`, but `+short` is a dig option.
const NAME = /^[a-z0-9.+_]+$/i;
const app = new Koa();
const router = new Router();

router.get('/dns', async (ctx) => {
  const name = ctx.query.name;
  if (typeof name !== 'string' || !NAME.test(name)) {
    ctx.status = 400;
    return;
  }
  const { stdout } = await run(`dig ${name} A`); // expect: security/no-shell-interpolation
  ctx.body = { raw: stdout };
});

app.use(router.routes());
app.listen(3000);
