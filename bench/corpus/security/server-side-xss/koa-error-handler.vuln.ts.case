// @bench category=server-side-xss cwe=CWE-79 framework=koa pair=koa-error-handler title="error middleware echoes the requested path"
import Koa, { Context, Next } from 'koa';

const app = new Koa();

async function errorPages(ctx: Context, next: Next): Promise<void> {
  try {
    await next();
    if (ctx.status !== 404) return;
    ctx.status = 404;
    ctx.type = 'text/html';
    ctx.body = `<h1>404</h1><p>Nothing lives at ${ctx.path}</p>`; // expect: security/require-sanitized-html, security/no-unescaped-html-response
  } catch (err) {
    ctx.status = 500;
    ctx.body = 'internal error';
  }
}

app.use(errorPages);
app.listen(4001);
