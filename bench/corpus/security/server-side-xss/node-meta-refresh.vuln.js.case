// @bench category=server-side-xss cwe=CWE-79 framework=node pair=node-meta-refresh title="meta refresh puts the escaped next parameter at the start of its URL"
const http = require('node:http');
const escapeHtml = require('escape-html');

http
  .createServer((req, res) => {
    const next = new URL(req.url, 'http://x').searchParams.get('next') || '/';
    res.writeHead(200, { 'Content-Type': 'text/html' });
    res.end(`<meta http-equiv="refresh" content="0; url=${escapeHtml(next)}"><p>Redirecting</p>`); // expect: security/no-unescaped-html-response
  })
  .listen(5007);
