// @bench category=server-side-xss cwe=CWE-79 framework=express pair=express-react-bio title="server-rendered React page injects bio via dangerouslySetInnerHTML"
import express from 'express';
import { renderToString } from 'react-dom/server';
import { getBio } from './bios';

function ProfilePage({ bio }: { bio: string }) {
  const body = { __html: bio }; // expect: security/require-sanitized-html
  return (
    <main>
      <h1>Profile</h1>
      <div className="bio" dangerouslySetInnerHTML={body} />
    </main>
  );
}

const app = express();

app.get('/profile/:id', async (req, res) => {
  const bio = await getBio(req.params.id);
  res.send('<!doctype html>' + renderToString(<ProfilePage bio={bio} />)); // expect: security/no-unescaped-html-response
});

app.listen(3005);
