// @bench category=server-side-xss cwe=CWE-79 framework=koa pair=koa-react-card title="server-rendered React card puts the headline in __html"
const Koa = require('koa');
const React = require('react');
const { renderToString } = require('react-dom/server');

function Card({ headline }) {
  return (
    <div className="card">
      <h2 dangerouslySetInnerHTML={{ __html: headline }} /> {/* expect: security/require-sanitized-html */}
    </div>
  );
}

const app = new Koa();

app.use(async (ctx) => {
  const headline = String(ctx.query.headline || 'Untitled');
  ctx.type = 'html';
  ctx.body = renderToString(<Card headline={headline} />); // expect: security/no-unescaped-html-response
});

app.listen(4006);
