// @bench category=server-side-xss cwe=CWE-79 framework=nest pair=nest-greeting-default title="handler with no Header decorator escapes the name it returns"
// ok
import { Controller, Get, Query } from '@nestjs/common';
import escapeHtml from 'escape-html';

@Controller('greet')
export class GreetController {
  @Get()
  hello(@Query('name') name = 'guest'): string {
    return `<p>Hello, ${escapeHtml(name)}!</p>`;
  }
}
