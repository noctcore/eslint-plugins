// @bench category=server-side-xss cwe=CWE-79 framework=express pair=express-layout-search title="search page escapes the query before the shared layout helper"
// ok
import express from 'express';
import escapeHtml from 'escape-html';
import { layout } from './layout';

const app = express();

app.get('/search', (req, res) => {
  const q = String(req.query.q ?? '');
  res.send(layout(`<h1>Results for ${escapeHtml(q)}</h1>`));
});

app.listen(3008);
