// @bench category=cookie-flags cwe=CWE-1004 framework=koa pair=koa-settings-token title="token cookie set httpOnly, secure and sameSite lax on login"
// ok
import Router from '@koa/router';
import type { Context } from 'koa';
import { login } from './auth';

const router = new Router();
const SUPPORTED = ['en', 'pl', 'de'];

router.post('/settings/session', async (ctx: Context) => {
  const token: string = await login(ctx.request.body);
  const lang = SUPPORTED.includes(ctx.request.body.lang) ? ctx.request.body.lang : 'en';
  ctx.cookies.set('token', token, { httpOnly: true, secure: true, sameSite: 'lax' });
  ctx.body = { ok: true };
});

export default router;
