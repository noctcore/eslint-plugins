// @bench category=cookie-flags cwe=CWE-1004 framework=express pair=express-conditional-flags title="cookie flags object built before every write, then spread"
// ok
import express from 'express';
import { createSession } from './auth';

const router = express.Router();

router.post('/login', express.json(), async (req, res) => {
  const sid = await createSession(req.body);
  let flags;
  flags = { httpOnly: true, secure: true, sameSite: 'lax' };
  res.cookie('session', sid, { ...flags, maxAge: 86_400_000 });
  res.json({ ok: true });
});

export default router;
