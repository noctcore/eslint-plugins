// @bench category=path-traversal cwe=CWE-22 framework=express pair=express-delete-attachment-rename-params title="attachment id from the route joined onto the dir and unlinked, rewritten by rename-params"
const fs = require('node:fs');
const path = require('node:path');
const express = require('express');

const ATTACH_DIR = path.resolve(__dirname, 'attachments');
const router = express.Router();
const attachments = new Map([
  ['a1', 'report.docx'],
  ['a2', 'photo.jpg'],
]);

router.delete('/attachments/:id', async (param1, param2) => {
  const target = path.join(ATTACH_DIR, param1.params.id); // expect: security/require-path-containment
  await fs.promises.unlink(target);
  param2.sendStatus(204);
});

module.exports = router;
