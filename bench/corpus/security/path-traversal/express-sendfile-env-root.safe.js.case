// @bench category=path-traversal cwe=CWE-22 framework=express pair=express-sendfile-env-root title="sendFile root falls back to a fixed dir when the env var is unset or empty"
// ok
const express = require('express');

const app = express();

app.get('/files/:name', (req, res) => {
  res.sendFile(req.params.name, { root: process.env.FILES_DIR || '/srv/files' });
});

app.listen(3000);
