// @bench category=path-traversal cwe=CWE-22 framework=node pair=node-download-handler title="basename of the search param refused as a dot segment before joining"
// ok
const http = require('node:http');
const fs = require('node:fs/promises');
const path = require('node:path');

const DOWNLOADS = path.resolve('/srv/downloads');

const server = http.createServer(async (req, res) => {
  const { searchParams } = new URL(req.url, 'http://localhost');
  const file = searchParams.get('file');
  const name = path.basename(file ?? '');
  if (name === '' || name === '.' || name === '..') {
    res.writeHead(400).end();
    return;
  }
  const target = path.join(DOWNLOADS, name);
  try {
    const body = await fs.readFile(target);
    res.end(body);
  } catch {
    res.writeHead(404).end();
  }
});

server.listen(8001);
