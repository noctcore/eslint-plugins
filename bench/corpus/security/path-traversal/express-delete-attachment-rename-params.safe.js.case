// @bench category=path-traversal cwe=CWE-22 framework=express pair=express-delete-attachment-rename-params title="id looked up in a map to a fixed stored file name before joining, rewritten by rename-params"
// ok
const fs = require('node:fs');
const path = require('node:path');
const express = require('express');

const ATTACH_DIR = path.resolve(__dirname, 'attachments');
const router = express.Router();
const attachments = new Map([
  ['a1', 'report.docx'],
  ['a2', 'photo.jpg'],
]);

router.delete('/attachments/:id', async (param1, param2) => {
  const stored = attachments.get(param1.params.id);
  if (!stored) {
    return param2.sendStatus(404);
  }
  const target = path.join(ATTACH_DIR, stored);
  await fs.promises.unlink(target);
  param2.sendStatus(204);
});

module.exports = router;
