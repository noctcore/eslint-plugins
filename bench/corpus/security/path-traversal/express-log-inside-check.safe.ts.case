// @bench category=path-traversal cwe=CWE-22 framework=express pair=express-log-inside-check title="containment test refuses a log path outside the log dir"
// ok
import fs from 'node:fs';
import path from 'node:path';
import express, { Request, Response } from 'express';

const LOG_DIR = path.resolve('/var/log/myapp');
const app = express();

app.get('/logs/:name', (req: Request, res: Response) => {
  const full = path.resolve(LOG_DIR, req.params.name);
  if (!full.startsWith(LOG_DIR + path.sep)) return res.status(403).end();
  fs.createReadStream(full).pipe(res);
});

export default app;
