// @bench category=path-traversal cwe=CWE-22 framework=express pair=express-fsextra-remove title="fs-extra remove on a body name joined onto the uploads dir"
const fse = require('fs-extra');
const path = require('node:path');
const express = require('express');

const UPLOADS = path.resolve('/srv/uploads');
const app = express();
app.use(express.json());

app.post('/uploads/delete', async (req, res) => {
  await fse.remove(path.join(UPLOADS, String(req.body.name))); // expect: security/require-path-containment
  res.status(204).end();
});

app.listen(3000);
