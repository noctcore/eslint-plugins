// @bench category=path-traversal cwe=CWE-22 framework=express pair=express-cache-purge title="basename refused as empty and as dot segments before removing the cache entry"
// ok
import fs from 'node:fs';
import path from 'node:path';
import express, { Request, Response } from 'express';

const CACHE = path.resolve('/var/cache/thumbs');
const app = express();

app.delete('/cache', (req: Request, res: Response) => {
  const key = path.basename(String(req.query.key));
  if (!key || key === '.' || key === '..') return res.status(400).end();
  fs.rmSync(path.join(CACHE, key), { recursive: true, force: true });
  res.status(204).end();
});

export default app;
