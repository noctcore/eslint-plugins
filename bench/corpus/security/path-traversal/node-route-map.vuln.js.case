// @bench category=path-traversal cwe=CWE-22 framework=node pair=node-route-map title="url pathname concatenated into a pages file path and read"
const http = require('node:http');
const fs = require('node:fs');

const PAGES = '/srv/site/pages';
const ROUTES = { '/': 'index.html', '/about': 'about.html', '/pricing': 'pricing.html' };

http.createServer((req, res) => {
  const { pathname } = new URL(req.url, 'http://localhost');
  const file = PAGES + pathname + '.html';
  fs.readFile(file, 'utf8', (err, html) => { // expect: security/require-path-containment
    res.writeHead(err ? 500 : 200, { 'content-type': 'text/html' });
    res.end(err ? 'error' : html);
  });
}).listen(8002);
