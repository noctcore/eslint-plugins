// @bench category=open-redirect cwe=CWE-601 framework=node pair=sveltekit-login-redirect-to title="login action redirects only to a same-site redirectTo path"
// ok
import { fail, redirect } from '@sveltejs/kit';

const LOCAL = /^\/(?!\/|\\)[!-~]*$/;

export const actions = {
  default: async ({ request, url, cookies }) => {
    const form = await request.formData();
    if (!form.get('email')) {
      return fail(400, { missing: true });
    }
    cookies.set('session', String(form.get('email')), { path: '/' });
    const redirectTo = url.searchParams.get('redirectTo') ?? '/';
    const ok = LOCAL.test(redirectTo);
    redirect(303, ok ? redirectTo : '/');
  },
};
