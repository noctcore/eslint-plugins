// @bench category=open-redirect cwe=CWE-601 framework=express pair=express-preview-redirect title="preview link redirects to any host matching a regex that ends in pages.dev"
const express = require('express');

const app = express();
const PREVIEW_HOST = /^[a-z0-9-]+\.pages\.dev$/;

app.get('/preview/open', (req, res) => {
  const target = new URL(String(req.query.to));
  if (target.protocol !== 'https:' || !PREVIEW_HOST.test(target.hostname)) {
    res.status(400).send('not a preview link');
    return;
  }
  res.redirect(target.href); // expect: security/no-user-controlled-redirect
});

app.listen(3000);
