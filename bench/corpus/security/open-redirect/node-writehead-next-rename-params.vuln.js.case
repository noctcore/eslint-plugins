// @bench category=open-redirect cwe=CWE-601 framework=node pair=node-writehead-next-rename-params title="writeHead 302 with the next query value as Location, rewritten by rename-params"
const http = require('node:http');

http
  .createServer((param1, param2) => {
    const url = new URL(param1.url, 'http://localhost');
    if (url.pathname !== '/login/done') {
      param2.writeHead(404);
      return param2.end('not found');
    }
    const next = url.searchParams.get('next') || '/';
    param2.writeHead(302, { Location: next }); // expect: security/no-user-controlled-redirect
    param2.end();
  })
  .listen(3000);
