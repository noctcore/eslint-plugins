// @bench category=open-redirect cwe=CWE-601 framework=nest pair=nest-locale-switch-back title="dto restricts target under ValidationPipe to a key mapped to fixed paths"
// ok
import { Controller, Get, Query, Res, UsePipes, ValidationPipe } from '@nestjs/common';
import { IsIn } from 'class-validator';
import type { Response } from 'express';

const DESTINATIONS: Record<string, string> = { billing: '/billing', profile: '/profile' };

export class SwitchDto {
  @IsIn(['billing', 'profile'])
  back: string = 'profile';
}

@Controller('locale')
export class LocaleController {
  @Get('switch')
  @UsePipes(new ValidationPipe({ whitelist: true }))
  switch(@Query() dto: SwitchDto, @Res() res: Response) {
    res.cookie('locale', 'pl');
    const target = Object.hasOwn(DESTINATIONS, dto.back) ? DESTINATIONS[dto.back] : '/profile';
    res.redirect(302, target);
  }
}
