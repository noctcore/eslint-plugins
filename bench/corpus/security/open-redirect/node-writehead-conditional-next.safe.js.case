// @bench category=open-redirect cwe=CWE-601 framework=node pair=node-writehead-conditional-next title="next must be a same-site path before the conditional Location holder"
// ok
const http = require('node:http');

const LOCAL = /^\/(?!\/|\\)[!-~]*$/;

function handler(req, res) {
  const url = new URL(req.url, 'http://localhost');
  const next = url.searchParams.get('next') || '';
  const ok = LOCAL.test(next);
  const target = ok ? next : '/';
  res.writeHead(next ? 302 : 200, next ? { Location: target } : { 'Content-Type': 'text/plain' });
  res.end(next ? '' : 'saved');
}

http.createServer(handler).listen(3000);
