// @bench category=ssrf cwe=CWE-918 framework=koa pair=koa-upstream-settings title="settings endpoint sets the axios default base URL from the request body"
const Koa = require('koa');
const Router = require('@koa/router');
const bodyParser = require('koa-bodyparser');
const axios = require('axios');

const router = new Router();

router.put('/settings/upstream', async (ctx) => {
  axios.defaults['baseURL'] = ctx.request.body.apiBase; // expect: security/no-user-controlled-fetch-url
  const res = await axios.get('/status');
  ctx.body = { ok: res.status < 300 };
});

const app = new Koa();
app.use(bodyParser()).use(router.routes());
app.listen(3000);
