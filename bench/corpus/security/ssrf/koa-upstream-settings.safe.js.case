// @bench category=ssrf cwe=CWE-918 framework=koa pair=koa-upstream-settings title="settings endpoint picks the axios default base URL from two fixed regions"
// ok
const Koa = require('koa');
const Router = require('@koa/router');
const bodyParser = require('koa-bodyparser');
const axios = require('axios');

const router = new Router();

router.put('/settings/upstream', async (ctx) => {
  const { region } = ctx.request.body;
  if (region === 'eu') {
    axios.defaults['baseURL'] = 'https://eu.api.example.com';
  } else if (region === 'us') {
    axios.defaults['baseURL'] = 'https://us.api.example.com';
  } else {
    ctx.throw(400, 'unknown region');
  }
  const res = await axios.get('/status');
  ctx.body = { ok: res.status < 300 };
});

const app = new Koa();
app.use(bodyParser()).use(router.routes());
app.listen(3000);
