// @bench category=ssrf cwe=CWE-918 framework=node pair=node-pages-snapshot title="snapshot fetches any URL whose host matches a regex that ends in github.io"
const http = require('node:http');

const PAGES_HOST = /^[a-z0-9-]+\.github\.io$/;

const server = http.createServer(async (req, res) => {
  const incoming = new URL(req.url, 'http://localhost');
  const target = new URL(incoming.searchParams.get('page') ?? '');
  if (target.protocol !== 'https:' || !PAGES_HOST.test(target.hostname)) {
    res.writeHead(400).end();
    return;
  }
  const page = await fetch(target); // expect: security/no-user-controlled-fetch-url
  res.writeHead(200, { 'Content-Type': 'text/html' });
  res.end(await page.text());
});

server.listen(3000);
